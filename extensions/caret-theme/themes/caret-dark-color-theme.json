{
  "name": "Carnet Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#b8b5af",
    "descriptionForeground": "#7d7a74",
    "errorForeground": "#e5675d",
    "focusBorder": "#2b8fe0",
    "widget.shadow": "#00000080",
    "selection.background": "#2b8fe055",
    "icon.foreground": "#9a978f",

    "editor.background": "#0b0b0b",
    "editor.foreground": "#d4d2cc",
    "editorLineNumber.foreground": "#55534f",
    "editorLineNumber.activeForeground": "#b8b5af",
    "editorCursor.foreground": "#2b8fe0",
    "editor.selectionBackground": "#2b8fe040",
    "editor.inactiveSelectionBackground": "#ffffff14",
    "editor.lineHighlightBackground": "#ffffff08",
    "editor.lineHighlightBorder": "#00000000",
    "editor.wordHighlightBackground": "#ffffff14",
    "editor.findMatchBackground": "#2b8fe066",
    "editor.findMatchHighlightBackground": "#2b8fe033",
    "editorIndentGuide.background1": "#1f1f1f",
    "editorIndentGuide.activeBackground1": "#363636",
    "editorWhitespace.foreground": "#2a2a2a",
    "editorBracketMatch.background": "#2b8fe033",
    "editorBracketMatch.border": "#2b8fe0",
    "editorGutter.background": "#0b0b0b",
    "editorWidget.background": "#111111",
    "editorWidget.border": "#2a2a2a",
    "editorSuggestWidget.background": "#111111",
    "editorSuggestWidget.border": "#2a2a2a",
    "editorSuggestWidget.selectedBackground": "#1b1b1b",
    "editorHoverWidget.background": "#111111",
    "editorHoverWidget.border": "#2a2a2a",
    "diffEditor.insertedTextBackground": "#2ea04326",
    "diffEditor.removedTextBackground": "#e5675d26",

    "activityBar.background": "#111111",
    "activityBar.foreground": "#ecebe8",
    "activityBar.inactiveForeground": "#6b6964",
    "activityBar.border": "#111111",
    "activityBarBadge.background": "#2b8fe0",
    "activityBarBadge.foreground": "#ffffff",
    "activityBar.activeBorder": "#2b8fe0",

    "sideBar.background": "#111111",
    "sideBar.foreground": "#b8b5af",
    "sideBar.border": "#111111",
    "sideBarTitle.foreground": "#9a978f",
    "sideBarSectionHeader.background": "#111111",
    "sideBarSectionHeader.foreground": "#b8b5af",
    "sideBarSectionHeader.border": "#1a1a1a",

    "titleBar.activeBackground": "#111111",
    "titleBar.activeForeground": "#b8b5af",
    "titleBar.inactiveBackground": "#111111",
    "titleBar.inactiveForeground": "#6b6964",
    "titleBar.border": "#111111",
    "menu.background": "#151515",
    "menu.foreground": "#d4d2cc",
    "menu.selectionBackground": "#26231f",
    "menu.separatorBackground": "#2a2a2a",
    "menubar.selectionBackground": "#ffffff14",

    "tab.activeBackground": "#0b0b0b",
    "tab.activeForeground": "#ecebe8",
    "tab.activeBorderTop": "#2b8fe0",
    "tab.inactiveBackground": "#111111",
    "tab.inactiveForeground": "#7d7a74",
    "tab.border": "#111111",
    "tab.hoverBackground": "#161616",
    "editorGroupHeader.tabsBackground": "#111111",
    "editorGroupHeader.tabsBorder": "#111111",
    "editorGroup.border": "#1a1a1a",
    "breadcrumb.background": "#0b0b0b",
    "breadcrumb.foreground": "#7d7a74",

    "panel.background": "#0b0b0b",
    "panel.border": "#1a1a1a",
    "panelTitle.activeForeground": "#ecebe8",
    "panelTitle.inactiveForeground": "#7d7a74",
    "panelTitle.activeBorder": "#2b8fe0",
    "terminal.background": "#0b0b0b",
    "terminal.foreground": "#d4d2cc",
    "terminalCursor.foreground": "#2b8fe0",

    "statusBar.background": "#111111",
    "statusBar.foreground": "#8d8a83",
    "statusBar.border": "#111111",
    "statusBar.noFolderBackground": "#111111",
    "statusBar.debuggingBackground": "#2b8fe0",
    "statusBarItem.hoverBackground": "#ffffff14",
    "statusBarItem.remoteBackground": "#1b1b1b",
    "statusBarItem.remoteForeground": "#ecebe8",

    "list.activeSelectionBackground": "#1f1f1f",
    "list.activeSelectionForeground": "#ecebe8",
    "list.inactiveSelectionBackground": "#181613",
    "list.hoverBackground": "#161616",
    "list.focusBackground": "#1f1f1f",
    "list.highlightForeground": "#2b8fe0",
    "tree.indentGuidesStroke": "#2a2a2a",

    "input.background": "#151515",
    "input.border": "#2a2a2a",
    "input.foreground": "#ecebe8",
    "input.placeholderForeground": "#6b6964",
    "inputOption.activeBorder": "#2b8fe0",
    "dropdown.background": "#151515",
    "dropdown.border": "#2a2a2a",
    "button.background": "#e9e7e2",
    "button.foreground": "#0b0b0b",
    "button.hoverBackground": "#ffffff",
    "button.secondaryBackground": "#1f1f1f",
    "button.secondaryForeground": "#d4d2cc",
    "badge.background": "#2b8fe0",
    "badge.foreground": "#ffffff",
    "progressBar.background": "#2b8fe0",
    "scrollbarSlider.background": "#ffffff14",
    "scrollbarSlider.hoverBackground": "#ffffff26",
    "scrollbarSlider.activeBackground": "#ffffff33",
    "textLink.foreground": "#4aa3f0",
    "textCodeBlock.background": "#151515",

    "gitDecoration.modifiedResourceForeground": "#d7ba7d",
    "gitDecoration.untrackedResourceForeground": "#6bbf86",
    "gitDecoration.deletedResourceForeground": "#e5675d",
    "gitDecoration.ignoredResourceForeground": "#55534f",

    "notifications.background": "#151515",
    "notifications.border": "#2a2a2a",
    "quickInput.background": "#111111",
    "quickInputList.focusBackground": "#1f1f1f",
    "peekViewEditor.background": "#111111",
    "peekViewResult.background": "#111111",
    "peekViewTitle.background": "#111111"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6b6964", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a5d6a7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#f0a63a" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#e0c88a" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#6fc3c8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#d4d2cc" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#cfc0a8" } },
    { "scope": ["entity.name.tag", "meta.tag"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e0c88a" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#b8d4ff" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#9a978f" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#a5d6a7" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e5675d" } }
  ]
}
